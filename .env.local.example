# ──────────────────────────────────────────────
# ViralSlideMaker Environment Variables
# Copy to .env.local and fill in your values
# ──────────────────────────────────────────────

# Supabase — get from https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# AI — Google Gemini (text gen + Imagen image gen)
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...your-gemini-key

# Stock Photos — Pexels
# Get from https://www.pexels.com/api/
PEXELS_API_KEY=your-pexels-api-key

# Stripe — Payments & Subscriptions
# Get from https://dashboard.stripe.com/apikeys
# Use sk_test_/pk_test_ for dev, sk_live_/pk_live_ for production
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Stripe Webhook — for subscription events
# Local dev: run `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# Production: create endpoint at https://dashboard.stripe.com/webhooks
#   URL: https://viralslidemaker.com/api/webhooks/stripe
#   Events: checkout.session.completed, customer.subscription.updated,
#           customer.subscription.deleted, invoice.paid, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# Stripe Price IDs — create products in Stripe Dashboard → Product Catalog
STRIPE_PRICE_PLUS_MONTHLY=price_your-plus-monthly-id
STRIPE_PRICE_PRO_MONTHLY=price_your-pro-monthly-id
STRIPE_PRICE_CREDIT_PACK_10=price_your-credit-pack-10-id

# App URL — used for Stripe redirect URLs
# Dev: http://localhost:3000
# Production: https://viralslidemaker.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
