# ──────────────────────────────────────────────
# ViralSlideMaker Environment Variables
# Copy to .env.local and fill in your values
# (mirrors .env.local.example; this file is the canonical template
#  consumed by the Phase 73 cost-rails docs and CI checks)
# ──────────────────────────────────────────────

# Supabase — get from https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# AI — Google Gemini (text gen + Imagen image gen)
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...your-gemini-key

# Stock Photos — Pexels
PEXELS_API_KEY=your-pexels-api-key

# Stripe — Payments & Subscriptions
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
STRIPE_PRICE_PLUS_MONTHLY=price_your-plus-monthly-id
STRIPE_PRICE_PRO_MONTHLY=price_your-pro-monthly-id
STRIPE_PRICE_CREDIT_PACK_10=price_your-credit-pack-10-id

# App URL — used for Stripe redirect URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ──────────────────────────────────────────────
# Phase 73 (COST-04, COST-05) — style-from-reference vision extraction rails
# ──────────────────────────────────────────────
# Daily cost ceiling for the bill-alarm cron (USD). Default $5/day pre-PMF;
# the cron emits a structured warn when net spend for the day exceeds this.
STYLE_EXTRACTION_DAILY_COST_CEILING_USD=5
# Estimated USD cost per extraction call. Default $0.003 (per STACK.md estimate
# for 3 reference images at 1024×1024 + ~600-token JSON output on gemini-2.5-flash).
# Tune as launch telemetry refines real-world averages.
STYLE_EXTRACTION_PER_CALL_COST_USD=0.003
# Free-tier daily call cap (rolling 24h). Default 5 per Phase 73 CONTEXT.md.
STYLE_EXTRACTION_FREE_DAILY_CALL_CAP=5
# Free-tier max images per call. Default 3 per Phase 73 CONTEXT.md
# (5 calls × 3 images = 15 vision calls/day worst-case for a free user).
STYLE_EXTRACTION_FREE_DAILY_IMAGES_CAP=3
# Shared secret for Vercel cron Authorization header. Required for /api/cron/* routes.
# Generate with: openssl rand -hex 32
CRON_SECRET=replace-me-with-a-strong-random-string
